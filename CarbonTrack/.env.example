# ===================================================================
# CarbonTrack Environment Configuration (.env.example)
# Copy this file to .env and customize for your local setup
# ===================================================================

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=carbontrack
DB_USERNAME=root
DB_PASSWORD=YOUR_PASSWORD

# JWT Secret (minimum 32 characters for HMAC-SHA256)
JWT_SECRET=carbontrack_super_secure_jwt_secret_key_2026_min_256_bits_for_sha256

# Server Port (Spring Boot)
SERVER_PORT=8080

# Frontend API URL (for React Axios)
VITE_API_BASE_URL=http://localhost:8080/api
